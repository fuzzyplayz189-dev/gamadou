# ─── Pflicht ────────────────────────────────────────────
BOT_TOKEN=MTUwODE0NjQ2MDc0MTQ3MjMwNw.G8lGLZ.IDVFCxv5aww30v8Sm8PYllXHEnLNJhztlu73Nc

# ─── Optional ───────────────────────────────────────────
PREFIX=!
DEFAULT_STATUS=Managing Tickets

# ─── Dev Guild (für schnelleres Command-Testen) ─────────
# Wenn gesetzt, werden Commands nur in diesem Server registriert (sofort).
# Leer lassen für globale Registrierung (bis zu 1 Stunde Verzögerung).
# DEV_GUILD_ID=123456789012345678

# ─── MongoDB (optional) ─────────────────────────────────
# Nur ausfüllen wenn du MongoDB nutzen möchtest.
# Ohne diese Zeile verwendet der Bot automatisch lokale JSON-Dateien.
# MONGODB_URI=mongodb://localhost:27017/sumobot
# Oder MongoDB Atlas (kostenlos):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/sumobot
